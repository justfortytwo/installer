# Bash commands the assistant may run without asking. Installed by
# `fortytwo gate on`. Yours to tune; fortytwo never overwrites it.
#
# One JSON object per line: command_glob (required, matched against the WHOLE
# command), cwd_glob, expires_at (ISO 8601), approved_by, note. Lines that are
# malformed or expired are ignored.
#
# Everything not matched here is held for your approval. A command containing
# ; & | < > ` or $( is always held, whatever this file says (see [bash] in
# .claude/policy/capabilities.toml), which is what keeps the entries ending in *
# from being chained into something else. Keep to read-only commands that cannot
# run another program: no find, fd, rg, xargs, env, sh, node, python.
{"command_glob":"pwd","note":"where am I"}
{"command_glob":"date","note":"current time"}
{"command_glob":"date *","note":"current time, formatted"}
{"command_glob":"ls","note":"list files"}
{"command_glob":"ls *","note":"list files"}
{"command_glob":"cat *","note":"read files"}
{"command_glob":"head *","note":"read files"}
{"command_glob":"tail *","note":"read files"}
{"command_glob":"wc *","note":"count lines"}
{"command_glob":"grep *","note":"search files"}
{"command_glob":"git status","note":"read-only repo status"}
{"command_glob":"git diff","note":"read-only diff"}
{"command_glob":"git log --oneline -20","note":"read-only recent history"}
